# Every environment variable the workflows read. Names only; set values in the VM's n8n environment.

# Discord webhook that receives offers, claim results and workflow failures
HUNTER_DISCORD_WEBHOOK_URL=
# Forum thread (room) every message goes to; the per-kind settings below override it when set
HUNTER_DISCORD_THREAD_ID=
HUNTER_DISCORD_THREAD_OFFERS=
HUNTER_DISCORD_THREAD_CLAIMS=
HUNTER_DISCORD_THREAD_FAILURES=
HUNTER_DISCORD_THREAD_SUMMARY=

# Base URLs (checks point these at local fixtures)
HUNTER_FREE_FOR_DEV_URL=https://raw.githubusercontent.com/ripienaar/free-for-dev/master/README.md
HUNTER_LOWENDBOX_FEED_URL=https://lowendbox.com/feed/
HUNTER_OCI_API_BASE=https://iaas.<region>.oraclecloud.com

# Oracle Cloud claim target (see skills/provider-oracle)
HUNTER_OCI_TENANCY_OCID=
HUNTER_OCI_USER_OCID=
HUNTER_OCI_KEY_FINGERPRINT=
HUNTER_OCI_PRIVATE_KEY_PEM=
HUNTER_OCI_COMPARTMENT_OCID=
HUNTER_OCI_AVAILABILITY_DOMAIN=
HUNTER_OCI_SUBNET_OCID=
HUNTER_OCI_IMAGE_OCID=
HUNTER_OCI_SSH_PUBLIC_KEY=

# n8n settings the workflows need
NODE_FUNCTION_ALLOW_BUILTIN=crypto
